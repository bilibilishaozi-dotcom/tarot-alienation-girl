{
  "note": "蓝色魔女跳跃的目标角度。单位是度，正角度为 Unity 局部 Z 的逆时针。数值是 1 倍。jumpAmplitude 乘下蹲、蹬地、上升；fallAmplitude 乘下落和落地；顶点姿势保持 1 倍。sx/sy 不乘这两项，由检视面板的 squashStrength 拉向 1。待机正弦和走路不在这张表里。",
  "sign": "面向右：torso 正=后仰、负=前倾；thigh 正=膝向前上、负=腿向后；shin 正=反膝、负=正常屈膝；upper arm 正=向前、负=向后；lower arm 正=正常屈肘、负=反肘；hair_back 正=扫进身体、负=发尾后扬；hat 正=帽尖后下、负=帽尖上翘；coat_front 正=衣摆扫进腿、负=向外扬；coat_back 正=露出窄条。左右翻转只改根节点 scale.x。",
  "timing": {
    "crouch": 0.12,
    "crouchEase": "easeOut 1-(1-t)^3，从静态待机到下蹲。这段和蹬地仍保留约一半水平速度",
    "launch": 0.07,
    "launchEase": "easeIn t^2，从下蹲到蹬地。结束时 vy=JumpVelocity，并给头发帽子衣摆加上起跳冲量",
    "airBlendIn": 0.12,
    "land": 0.22,
    "impactHold": 0.04,
    "landEase": "前 0.04 秒保持落地姿势，之后 easeOut 回到静态待机。按住方向时后半段改为走向走路姿势",
    "boneSharpness": 30,
    "impactSharpness": 40,
    "impactSharpTime": 0.04,
    "dtMax": 0.033333,
    "gravity": -26,
    "jumpVelocity": 8.4,
    "apexGravity": "离墙时 gravMul = lerp(0.5, 1, inverseLerp(0, 2, abs(vy)))。贴墙仍用满重力。",
    "jumpBuffer": 0.14,
    "jumpAfterImpactHold": true,
    "airBlend": "u=clamp(vy/jumpVelocity,-1,1)；上升 SmoothStep(0.12,0.65,u) 混向 rise；下落 SmoothStep(0.12,0.85,-u) 混向 fall；中间是 apex。再在 0.12 秒内从 launch 混入。"
  },
  "squash": {
    "strength": "squashStrength，默认 1",
    "footAnchor": "走路、待机、下蹲、蹬地、落地都用 rig.y = -2.48 - sy*SoleLow，让最低的鞋跟或鞋尖贴地。触地看的是当前姿势的鞋底，不是髋部。落地那一帧把鞋底收到地面上。鞋跟/鞋尖：近侧 (-0.27,-1.47)/(0.43,-1.47)，远侧 (-0.17,-1.47)/(0.58,-1.47)。",
    "airPivot": "空中和贴墙绕髋部，高度目标是 0。贴墙进入、离开、以及贴墙落到地上时，姿势用 0.1 秒从当前显示姿势交叉到新目标，单关节每 1/60 秒最多转 12 度。",
    "landingImpact": "落地压扁（sx/sy）和弹簧冲量按触地速度缩放，速度 4 为满，慢速贴墙 1.4 约为 35%。"
  },
  "springs": {
    "strength": "springStrength，默认 1。乘到 ω 和冲量上。0 时改为和四肢一样的指数平滑。",
    "integrate": "v += (ω^2*(target-x) - 2*ζ*ω*v)*dt；x += v*dt。dt 上限 1/30。",
    "when": "下蹲、蹬地、空中和落地时积分。落地后再保持 0.7 秒，让摆动衰减。之后的待机和走路改回指数平滑，避免走路步频把 hair_back 放大。贴墙也用指数平滑，避免冲过原来的贴墙角度。",
    "hair_back": { "omega": 11, "zeta": 0.35, "takeoff": 70, "land": 120 },
    "hair_front": { "omega": 16, "zeta": 0.45, "takeoff": 40, "land": 60 },
    "hair_front_r": { "omega": 13, "zeta": 0.38, "takeoff": 60, "land": 90 },
    "hat": { "omega": 18, "zeta": 0.5, "takeoff": 60, "land": 50 },
    "coat_front": { "omega": 12, "zeta": 0.4, "takeoff": 60, "land": 90 },
    "coat_back": { "omega": 14, "zeta": 0.45, "takeoff": -30, "land": -40 }
  },
  "derivedScale": {
    "hair_back_sy": "clamp(1+0.0125*hair_back, 0.90, 1.04)",
    "coat_front_sy": "clamp(1+0.012*coat_front, 0.94, 1.03)",
    "coat_front_sx": "clamp(1-0.012*coat_front, 0.97, 1.06)",
    "when": "只在下蹲、蹬地、空中（不含贴墙）和落地时使用，再按 squashStrength 拉向 1。"
  },
